# ===== S7 Monitor — konfiguracja (skopiuj do .env: cp .env.example .env) =====

# Hasło do logowania (WYMAGANE). Użyj długiego, losowego hasła.
APP_PASSWORD=

# Sekret do podpisywania tokenów logowania. Zostaw puste — wygeneruje się sam
# i zapisze w data/secret.key. Zmiana sekretu wyloguje wszystkie urządzenia.
APP_SECRET=

# Pterodactyl — adres panelu i klucz Client API (zaczyna się od ptlc_).
# Te wartości NIGDY nie trafiają do bazy ani do przeglądarki.
PTERO_URL=https://panel.example.pl
PTERO_KEY=ptlc_

# Kontakt dla Web Push (VAPID). Wpisz swój prawdziwy e-mail — Apple tego wymaga.
VAPID_SUBJECT=mailto:twoj@email.pl

# Domena — potrzebna tylko dla wariantu A (Caddy z automatycznym HTTPS).
# Bez domeny: IP z kropkami zamienionymi na myślniki + .sslip.io, np. 51-75-12-34.sslip.io
DOMAIN=monitor.example.pl

# Strefa czasowa logów
TZ=Europe/Warsaw

# Zakładka „Serwer" (informacje o VPS-ie, usługi, konsole) nie wymaga ustawień:
# instalator uruchamia S7 Agenta, a docker-compose podłącza jego gniazdo.

# --- opcjonalne ---
# Maksymalna liczba równoległych sprawdzeń
CHECK_CONCURRENCY=8
# Ile dni trzymać historię pomiarów
RETENTION_DAYS=30
